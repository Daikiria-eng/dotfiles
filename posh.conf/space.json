{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "transient_prompt": {
    "foreground":"#7700FF",
    "foreground_templates":[
        "{{ if gt .Code 0}}#f54927{{ end }}"
    ],
    "template":"❯ "
  },
  "secondary_prompt": {
    "background": "transparent",
    "foreground": "#ffffff",
    "template": "❯ "
  },

  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "#26C6DA",
          "options": {
            "macos": "mac"
          },
          "style": "plain",
          "template": "\udb86\udca1 ",
          "type": "os"
        },
        {
          "type": "status",
          "style": "powerline",
          "template": "{{ if eq .Code 0 }}\uf00c{{ else }}<#ea2d2e>\udb80\udca7 {{ .Code }}</>{{ end }} ",
          "foreground": "#ffffff"
        },
        {
          "foreground": "#7700FF",
          "options": {
            "style": "folder"
          },
          "style": "powerline",
          "template": "{{ .Path }} ",
          "type": "path"
        },
        {
          "type": "git",
          "style": "powerline",
          "foreground": "#00FF16",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#00FF16{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#FFEB3B{{ end }}",
            "{{ if gt .Ahead 0 }}#FFCC80{{ end }}",
            "{{ if gt .Behind 0 }}#B388FF{{ end }}"
          ],
          "template": "{{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} ",
          "options": {
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "untracked_modes": {
              "/Users/user/Projects/oh-my-posh/": "no"
            },
            "source": "cli",
            "mapped_branches": {
              "feat/*": "🚀 ",
              "bug/*": "🐛 "
            }
          }
        },
        {
          "foreground": "#906cff",
          "style": "powerline",
          "template": "[\ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }}] ",
          "type": "python"
        },
        {
          "foreground": "#7FD5EA",
          "style": "powerline",
          "template": "[\ue626 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}] ",
          "type": "go"
        },
        {
          "foreground": "#76b367",
          "style": "powerline",
          "template": "[\ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }}] ",
          "type": "node"
        },
        {
          "foreground": "#f44336",
          "style": "powerline",
          "template": "[\ue791{{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}] ",
          "type": "ruby"
        },
        {
          "foreground": "#26C6DA",
          "style": "powerline",
          "template": "[\ue66d {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}] ",
          "type": "java"
        },
        {
          "foreground": "#4063D8",
          "style": "powerline",
          "template": " \ue624 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "type": "julia"
        },
        {
          "foreground": "#00FF16",
          "foreground_templates":[
            "{{ if gt .Code 0}}#f54927{{ end }}"
          ],
          "style": "plain",
          "template": "\uf101<#7700FF>❯</> ",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "version": 4
}
